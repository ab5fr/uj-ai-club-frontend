# =============================================================================
# UJ AI Club — Frontend environment
# Copy to .env.local (Next.js loads .env.local automatically).
# docker-compose.dev.yml also loads this file and overrides API/SITE URLs for local Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# Public URLs (exposed to the browser)
# -----------------------------------------------------------------------------
# Rust API base URL (default in code if unset: https://api.uj-aiclub.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical site URL for SEO / sitemap (default: https://uj-aiclub.com)
# Compose override in docker-compose.dev.yml: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only — never prefix with NEXT_PUBLIC_
# -----------------------------------------------------------------------------
# Blog / articles Postgres (Neon HTTP driver). Separate from Compose Postgres used by the API.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Preferred for server-side Firebase ID token verification (articles admin).
# Falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID if unset.
FIREBASE_PROJECT_ID=your-firebase-project-id

# -----------------------------------------------------------------------------
# Firebase client SDK (required for login)
# See FIREBASE_AUTH_SETUP.md / Firebase console → Project settings → Your apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — present in Firebase console; not read by current app code
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# -----------------------------------------------------------------------------
# Docker / Next tooling (usually set by Compose or Dockerfile.dev; optional locally)
# -----------------------------------------------------------------------------
# NEXT_TELEMETRY_DISABLED=1
# HOSTNAME=0.0.0.0
# PORT=3000
# WATCHPACK_POLLING=true
# CHOKIDAR_USEPOLLING=true
# CHOKIDAR_INTERVAL=1000
# WATCHPACK_POLLING_INTERVAL=1000
