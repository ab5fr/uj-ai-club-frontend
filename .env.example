# =============================================================================
# UJ AI Club — Frontend environment
# Copy to .env.local (Next.js loads .env.local automatically; keep secrets there).
# =============================================================================

# Public URLs (browser) — required; no code defaults
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never NEXT_PUBLIC_
# Blog/articles Neon Postgres (same DB as the API so admin role checks work)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Firebase client SDK (required for login)
# NEXT_PUBLIC_FIREBASE_PROJECT_ID is also used server-side to verify ID tokens for article admin
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
